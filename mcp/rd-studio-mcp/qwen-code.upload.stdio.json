{
  "mcpServers": {
    "rd-studio-upload": {
      "command": "node",
      "args": ["C:/replace-with/rd-studio-mcp/server.mjs"],
      "env": {
        "RD_STUDIO_URL": "https://rd-studio.club",
        "RD_STUDIO_UPLOAD_TOKEN": "replace-with-your-upload-token",
        "RD_STUDIO_KNOWLEDGE_WRITE": "1",
        "RD_STUDIO_NOTES_ROOT": "E:/replace-with/notes"
      },
      "timeout": 300000,
      "trust": false
    }
  }
}
